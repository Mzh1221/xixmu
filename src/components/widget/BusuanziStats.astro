---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout
	id="busuanzi-stats"
	name="统计"
	class:list={["busuanzi-stats-container", className, "cursor-pointer transition-opacity active:scale-95"]}
	{style}
>
	<a
		target="_blank"
		rel="noopener noreferrer"
		class="block"
		href="https://busuanzi.ibruce.info/"
	>
		<div class="text-center py-2">
			<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
				<span id="busuanzi_value_site_pv">-</span>
			</div>
			<div class="text-sm text-neutral-500 dark:text-neutral-400">总浏览量</div>
		</div>
		<div class="text-center pt-2 border-t border-neutral-200 dark:border-neutral-700">
			<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
				<span id="busuanzi_value_site_uv">-</span>
			</div>
			<div class="text-sm text-neutral-500 dark:text-neutral-400">访客数</div>
		</div>
	</a>
</WidgetLayout>

<script src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js" is:inline async></script>
