---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout
	id="busuanzi-stats"
	name="统计"
	class:list={["busuanzi-stats-container", className, "cursor-pointer transition-opacity active:scale-95"]}
	{style}
>
	<a
		target="_blank"
		rel="noopener noreferrer"
		class="block"
		href="https://www.busuanzi.cc/"
	>
		<div class="text-center py-2">
			<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
				<span id="busuanzi_site_pv">加载中...</span>
			</div>
			<div class="text-sm text-neutral-500 dark:text-neutral-400">总浏览量</div>
		</div>
		<div class="grid grid-cols-2 divide-x divide-neutral-200 dark:divide-neutral-700 text-center pt-2">
			<div class="px-2">
				<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
					<span id="busuanzi_site_uv">加载中...</span>
				</div>
				<div class="text-sm text-neutral-500 dark:text-neutral-400">访客数</div>
			</div>
			<div class="px-2">
				<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
					<span id="busuanzi_today_pv">加载中...</span>
				</div>
				<div class="text-sm text-neutral-500 dark:text-neutral-400">今日访问</div>
			</div>
		</div>
	</a>
</WidgetLayout>

<!-- 不蒜子 3.6.9 官方脚本（完整数字版） -->
<script src="//cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js" is:inline defer></script>
