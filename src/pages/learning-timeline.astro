---
import { getCollection } from "astro:content";
import { getPostUrlBySlug } from "@/utils/url-utils";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// ============ 收集所有带 timeline: true 的文章 ============
const timelinePosts = await getCollection("posts", ({ data }) => data.timeline === true);

interface TimelineItem {
	date: string;
	courses: string;
	id: string;
	url: string;
	title: string;
}

// ============ 解析每篇正文的「MM-DD 课程」行，合并 ============
const items: TimelineItem[] = [];
for (const post of timelinePosts) {
	const lines = post.body
		.split("\n")
		.map((l) => l.trim())
		.filter((l) => /^\d{1,2}-\d{1,2}(\s|$)/.test(l));
	for (const line of lines) {
		const m = line.match(/^(\d{1,2}-\d{1,2})\s*(.*)$/);
		if (m) items.push({ date: m[1], courses: m[2], id: post.id, url: getPostUrlBySlug(post.id), title: post.data.title });
	}
}

// ============ 按日期排序（同年假设，MM-DD → 年内第几天）============
const dayOfYear = (d: string): number => {
	const [m, dd] = d.split("-").map(Number);
	const cum = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
	return (cum[(m - 1) ?? 0] ?? 0) + (dd ?? 0);
};
items.sort((a, b) => dayOfYear(a.date) - dayOfYear(b.date));

// ============ 统计 ============
const totalDays = new Set(items.map((i) => i.date)).size;
const totalCourses = items.reduce(
	(sum, i) => sum + (i.courses.match(/\[\[[^\]]+\]\]/g)?.length ?? 0),
	0,
);
const totalTarget = timelinePosts.reduce(
	(sum, p) => sum + (Number(p.data.timelineTotal) || 0),
	0,
);

// 统计单行内 [[课程]] 数量
const countCourses = (s: string) => (s.match(/\[\[[^\]]+\]\]/g)?.length ?? 0);

// 各系列总览（用于顶部卡片 + 筛选）
const seriesList = timelinePosts.map((post) => {
	const its = items.filter((i) => i.id === post.id);
	const days = new Set(its.map((i) => i.date)).size;
	const courses = its.reduce((sum, i) => sum + countCourses(i.courses), 0);
	const target = Number(post.data.timelineTotal) || 0;
	return {
		id: post.id,
		title: post.data.title,
		days,
		courses,
		target,
		pct: target > 0 ? Math.min(100, Math.round((courses / target) * 100)) : 0,
	};
});

// 本周（周一起）完成的课程数
const now = new Date();
const startOfYear = new Date(now.getFullYear(), 0, 1);
const todayDoy = Math.floor((now.getTime() - startOfYear.getTime()) / 86400000) + 1;
const mondayDoy = todayDoy - ((now.getDay() + 6) % 7);
const weekCourses = items.reduce((sum, i) => {
	const d = dayOfYear(i.date);
	if (d < mondayDoy || d > mondayDoy + 6) return sum;
	return sum + countCourses(i.courses);
}, 0);


// ============ [[xxx]] → 链接（与 LearningTimeline 一致）============
function renderContent(text: string): string {
	return text.replace(
		/\[\[([^\[\]\n]+?)(?:\|([^\[\]\n]*))?\]\]/g,
		(_: string, target: string, alias?: string) => {
			const slug = target.trim();
			const label = (alias && alias.trim()) || slug;
			const href = `/posts/${encodeURIComponent(slug)}/`;
			return `<a href="${href}">${label}</a>`;
		},
	);
}

const title = "学习时间线";
const description = `已收录 ${timelinePosts.length} 条学习记录系列，共 ${totalCourses} 课`;
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<!-- 页面标题 -->
			<div class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
						<Icon is:inline name="material-symbols:timeline" class="text-[1.5rem]"></Icon>
					</div>
					<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
						{title}
					</div>
				</div>
				<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
					{description}
				</p>
			</div>

			<!-- 聚合时间线 -->
			{
				items.length > 0 ? (
					<div class="learning-timeline">
						<div class="tl-stats">
							<span class="tl-stat">
								已学习 <strong>{totalDays}</strong> 天
							</span>
							<span class="tl-stat">
								完成 <strong>{totalCourses}</strong>
								{totalTarget > 0 && <>/{totalTarget}</>} 课
							</span>
							<span class="tl-stat">
								本周 <strong>{weekCourses}</strong> 课
							</span>

						</div>
						<div class="tl-series">
							{seriesList.map((s) => (
								<button
									type="button"
									class="tl-series-card"
									data-filter={s.id}
									title="点击筛选该系列，再点取消"
								>
									<div class="tl-series-name">{s.title}</div>
									<div class="tl-series-bar">
										<div class="tl-series-fill" style={`width: ${s.pct}%`} />
									</div>
									<div class="tl-series-meta">
										{s.courses}/{s.target} 课 · {s.days} 天 · {s.pct}%
									</div>
								</button>
							))}
						</div>
						<div class="tl-list">
							{[...items].reverse().map((item, idx) => (
								<div
									class:list={["tl-row", idx < 3 && "tl-row-recent"]}
									data-series={item.id}
								>
									<div class="tl-rail" aria-hidden="true">
										<span class="tl-node" />
									</div>
									<div class="tl-body">
										<div class="tl-date">
											{item.date}
											{idx < 3 && <span class="tl-recent-badge">最近</span>}
											<a class="tl-source" href={item.url}>
												{item.title}
											</a>
										</div>
										<div class="tl-content" set:html={renderContent(item.courses)} />
									</div>
								</div>
							))}
						</div>
					</div>
				) : (
					<p class="tl-empty">暂无学习记录</p>
				)
			}
		</div>
	</div>
</MainGridLayout>

<style>
	.learning-timeline {
		position: relative;
		padding: 1.25rem 1.5rem 1rem;
		background: var(--card-bg);
		border: 1px solid color-mix(in srgb, var(--line-divider) 50%, transparent);
		border-radius: var(--radius-large);
	}

	.tl-list {
		position: relative;
	}

	.tl-list::before {
		content: "";
		position: absolute;
		top: 0.5rem;
		bottom: 0.25rem;
		left: calc(1rem - 1px);
		width: 2px;
		border-left: 2px dashed color-mix(in srgb, var(--line-color) 85%, transparent);
	}

	.tl-stats {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.625rem 1.25rem;
		margin-bottom: 0.875rem;
		padding: 0.625rem 0.875rem;
		border-radius: calc(var(--radius-large) - 0.375rem);
		background: color-mix(in srgb, var(--primary) 8%, transparent);
		color: var(--content-meta);
		font-size: 0.85rem;
	}

	.tl-stat strong {
		color: var(--primary);
		font-weight: 700;
	}

	.tl-row {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.875rem;
		padding: 0.5rem 0 0.75rem;
	}

	.tl-rail {
		position: relative;
	}

	.tl-node {
		position: absolute;
		top: 0.4rem;
		left: 50%;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: oklch(0.5 0.05 var(--hue));
		border: 2.5px solid var(--card-bg);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--line-color) 55%, transparent);
		transform: translateX(-50%);
	}

	.tl-body {
		min-width: 0;
	}

	.tl-date {
		margin-bottom: 0.125rem;
		color: var(--content-meta);
		font-size: 0.75rem;
		line-height: 1.4;
	}

	.tl-source {
		margin-left: 0.625rem;
		padding: 0.0625rem 0.5rem;
		border-radius: 999px;
		font-size: 0.7rem;
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--primary);
		text-decoration: none;
	}

	.tl-source:hover {
		text-decoration: underline;
	}

	.tl-content {
		color: rgb(0 0 0 / 90%);
		font-size: 0.95rem;
		line-height: 1.75;
		overflow-wrap: anywhere;
	}

	.tl-content :global(a) {
		margin-right: 0.875rem;
		color: var(--primary);
		text-decoration: none;
		white-space: nowrap;
	}

	.tl-content :global(a:hover) {
		text-decoration: underline;
	}

	.tl-empty {
		color: var(--content-meta);
		font-size: 0.9rem;
		padding: 2rem;
		text-align: center;
	}

	/* 系列总览卡片（可点击筛选） */
	.tl-series {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.tl-series-card {
		text-align: left;
		padding: 0.75rem;
		border-radius: calc(var(--radius-large) - 0.375rem);
		border: 1px solid color-mix(in srgb, var(--line-divider) 60%, transparent);
		background: color-mix(in srgb, var(--primary) 4%, transparent);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.tl-series-card:hover {
		border-color: color-mix(in srgb, var(--primary) 60%, transparent);
	}

	.tl-series-card.active {
		border-color: var(--primary);
		background: color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.tl-series-name {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--content-text);
		margin-bottom: 0.375rem;
	}

	.tl-series-bar {
		height: 0.375rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--content-meta) 18%, transparent);
		overflow: hidden;
		margin-bottom: 0.375rem;
	}

	.tl-series-fill {
		height: 100%;
		border-radius: 999px;
		background: var(--primary);
		transition: width 0.4s ease;
	}

	.tl-series-meta {
		font-size: 0.75rem;
		color: var(--content-meta);
	}

	/* 最近 3 条高亮 */
	.tl-row-recent .tl-node {
		background: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 30%, transparent);
	}

	.tl-row-recent .tl-date {
		color: var(--primary);
		font-weight: 600;
	}

	.tl-recent-badge {
		margin-left: 0.5rem;
		padding: 0 0.375rem;
		border-radius: 999px;
		font-size: 0.65rem;
		font-weight: 600;
		color: #fff;
		background: var(--primary);
		vertical-align: 0.05em;
	}

	@media (max-width: 640px) {
		.learning-timeline {
			padding: 1rem 1rem 0.75rem;
		}

		.tl-list::before {
			left: calc(0.75rem - 1px);
		}

		.tl-row {
			grid-template-columns: 1.5rem 1fr;
			gap: 0.625rem;
		}

		.tl-series {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>

<script is:inline>
	// 系列筛选：点击卡片只看该系列，再点取消（事件委托，SPA 导航后仍有效）
	// 注意：is:inline 脚本不经过编译，必须用纯 JS，不能写 TS 语法（如 as 断言）
	(() => {
		document.addEventListener("click", function (e) {
			var t = e.target;
			var btn = t && t.closest ? t.closest("[data-filter]") : null;
			if (!btn) return;
			var isActive = btn.classList.contains("active");
			document.querySelectorAll("[data-filter]").forEach(function (b) {
				b.classList.remove("active");
			});
			if (!isActive) btn.classList.add("active");
			var active = document.querySelector("[data-filter].active");
			document.querySelectorAll("[data-series]").forEach(function (row) {
				row.style.display =
					active && row.dataset.series !== active.dataset.filter ? "none" : "";
			});
		});
	})();
</script>
