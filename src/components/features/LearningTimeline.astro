---
/**
 * LearningTimeline — 学习进度时间线组件
 * 解析「MM-DD 课程」格式的正文，渲染为时间线（竖线+节点+日期+课程链接）
 * 用法：文章 frontmatter 加 timeline: true 即可自动启用
 */
interface Props {
	body: string;
	/** 目标课程数，设置后显示完成度进度条 */
	target?: number;
}

const { body, target = 0 } = Astro.props;

// 解析每行：MM-DD 内容...
const lines = body
	.split("\n")
	.map((l) => l.trim())
	.filter((l) => /^\d{1,2}-\d{1,2}(\s|$)/.test(l));

const items = lines.map((line) => {
	const m = line.match(/^(\d{1,2}-\d{1,2})\s*(.*)$/);
	return { date: m?.[1] ?? "", content: m?.[2] ?? "" };
});

// 进度统计
const totalDays = items.length;
const totalCourses = items.reduce(
	(sum, item) => sum + (item.content.match(/\[\[[^\]]+\]\]/g)?.length ?? 0),
	0,
);
const pct = target > 0 ? Math.min(100, Math.round((totalCourses / target) * 100)) : 0;

// [[xxx]] → /posts/xxx/ 链接（与 Firefly remark-wiki-link 一致）
function renderContent(text: string): string {
	return text.replace(/\[\[([^[\]\n]+)\]\]/g, (_, target: string) => {
		const slug = target.trim();
		const href = `/posts/${encodeURIComponent(slug)}/`;
		return `<a href="${href}">${slug}</a>`;
	});
}
---

{
	items.length > 0 ? (
		<div class="learning-timeline">
			<div class="tl-stats">
				<span class="tl-stat">
					已学习 <strong>{totalDays}</strong> 天
				</span>
				<span class="tl-stat">
					完成 <strong>{totalCourses}</strong>
					{target > 0 && <>/{target}</>} 课
				</span>
				{target > 0 && (
					<div class="tl-progress">
						<div class="tl-progress-bar">
							<div class="tl-progress-fill" style={`width: ${pct}%`} />
						</div>
						<span class="tl-progress-label">{pct}%</span>
					</div>
				)}
			</div>
			<div class="tl-list">
			{items.map((item) => (
				<div class="tl-row">
					<div class="tl-rail" aria-hidden="true">
						<span class="tl-node" />
					</div>
					<div class="tl-body">
						<div class="tl-date">{item.date}</div>
						<div class="tl-content" set:html={renderContent(item.content)} />
					</div>
				</div>
			))}
			</div>
		</div>
	) : (
		<p class="tl-empty">暂无学习记录</p>
	)
}

<style>
	.learning-timeline {
		position: relative;
		padding: 1.25rem 1.5rem 1rem;
		background: var(--card-bg);
		border: 1px solid color-mix(in srgb, var(--line-divider) 50%, transparent);
		border-radius: var(--radius-large);
	}

	/* 条目区：竖线只画在列表区域，不穿过统计条 */
	.tl-list {
		position: relative;
	}

	.tl-list::before {
		content: "";
		position: absolute;
		top: 0.5rem;
		bottom: 0.25rem;
		left: calc(1rem - 1px);
		width: 2px;
		border-left: 2px dashed color-mix(in srgb, var(--line-color) 85%, transparent);
	}

	.tl-stats {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.625rem 1.25rem;
		margin-bottom: 0.875rem;
		padding: 0.625rem 0.875rem;
		border-radius: calc(var(--radius-large) - 0.375rem);
		background: color-mix(in srgb, var(--primary) 8%, transparent);
		color: var(--content-meta);
		font-size: 0.85rem;
	}

	.tl-stat strong {
		color: var(--primary);
		font-weight: 700;
	}

	.tl-progress {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-left: auto;
		min-width: 10rem;
	}

	.tl-progress-bar {
		flex: 1;
		height: 0.5rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--content-meta) 18%, transparent);
		overflow: hidden;
	}

	.tl-progress-fill {
		height: 100%;
		border-radius: 999px;
		background: var(--primary);
		transition: width 0.4s ease;
	}

	.tl-progress-label {
		font-size: 0.78rem;
		color: var(--primary);
		font-weight: 600;
		min-width: 2.5rem;
		text-align: right;
	}

	.tl-row {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.875rem;
		padding: 0.5rem 0 0.75rem;
	}

	.tl-rail {
		position: relative;
	}

	/* 节点：小圆点 + 描边（与动态页一致） */
	.tl-node {
		position: absolute;
		top: 0.4rem;
		left: 50%;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: oklch(0.5 0.05 var(--hue));
		border: 2.5px solid var(--card-bg);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--line-color) 55%, transparent);
		transform: translateX(-50%);
	}

	.tl-body {
		min-width: 0;
	}

	/* 日期：左上角小字 */
	.tl-date {
		margin-bottom: 0.125rem;
		color: var(--content-meta);
		font-size: 0.75rem;
		line-height: 1.4;
	}

	/* 课程内容 */
	.tl-content {
		color: rgb(0 0 0 / 90%);
		font-size: 0.95rem;
		line-height: 1.75;
		overflow-wrap: anywhere;
	}

	.tl-content :global(a) {
		margin-right: 0.875rem;
		color: var(--primary);
		text-decoration: none;
		white-space: nowrap;
	}

	.tl-content :global(a:hover) {
		text-decoration: underline;
	}

	.tl-empty {
		color: var(--content-meta);
		font-size: 0.9rem;
		padding: 2rem;
		text-align: center;
	}

	@media (max-width: 640px) {
		.learning-timeline {
			padding: 1rem 1rem 0.75rem;
		}

		.tl-list::before {
			left: calc(0.75rem - 1px);
		}

		.tl-row {
			grid-template-columns: 1.5rem 1fr;
			gap: 0.625rem;
		}
	}
</style>
